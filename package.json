{
  "name": "csi-ultimate",
  "version": "9.0.0",
  "description": "CSI-Ultimate Web Crawler — Multi-site classifieds scraper with adaptive discovery engine",
  "type": "module",
  "scripts": {
    "start": "node run.mjs",
    "serve": "node web/server.mjs",
    "report:completeness": "node scripts/analytics/field-completeness.mjs",
    "report:alerts": "node scripts/analytics/tender-alerts.mjs",
    "harvest:gaps": "node scripts/analytics/harvest-gaps.mjs",
    "design:hawkers": "node scripts/design/hawkers-offline.mjs",
    "start:legacy": "node scripts/legacy/crawlers/csi-crawler-v9.mjs",
    "test:legacy": "node scripts/legacy/crawlers/csi-crawler-v9.mjs --test",
    "test:live": "node scripts/legacy/crawlers/csi-crawler-v9.mjs --test-live",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:db": "node --test --test-force-exit tests/db.test.mjs",
    "db:import": "node scripts/db-import.mjs",
    "stage2a": "node scripts/stage-tests/test-stage2a.mjs",
    "stage2b": "node scripts/stage-tests/test-stage2b.mjs",
    "stage3": "node scripts/stage-tests/test-stage3.mjs",
    "stage4": "node scripts/stage-tests/test-stage4.mjs",
    "stage5": "node scripts/stage-tests/test-stage5.mjs",
    "lint": "node --check run.mjs",
    "hunt": "node scripts/job-hunter/run-hunter.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "cloudscraper": "^4.6.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.0",
    "playwright": "^1.52.0",
    "playwright-extra": "^4.3.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  }
}