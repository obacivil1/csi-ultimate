# ============================================================
# CSI-Ultimate Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# ---------- Core ----------
NODE_ENV=development            # development | production | test
PORT=3000                       # web app port
TZ=Asia/Riyadh

# ---------- Security ----------
JWT_SECRET=change-me-please     # REQUIRED for web auth
BCRYPT_ROUNDS=10
# Reverse-proxy hops to trust for req.ip. Render alone=1, behind Cloudflare=2.
# NEVER set to a permissive value — clients could then spoof their IP.
TRUST_PROXY=1

# ---------- PayPal ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=

# ---------- Cloudflare Turnstile (optional bot protection) ----------
# Leave blank to disable. When SECRET_KEY is set, /register and /login require a token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- SMTP / Email ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@csi-ultimate.com
FROM_NAME=CSI Ultimate

# ---------- Scraper ----------
CSI_PORT=3030                   # engine API port
SCRAPER_UI_PORT=3456            # legacy scraper UI port
CSI_LOG_LEVEL=INFO              # INFO | DEBUG | WARN | ERROR | SILENT
CSI_UAT=0                       # set 1 for UAT instrumentation
CSI_HARD_MODE=0
CSI_EXTREME_MODE=0
CSI_PROXY=                      # proxy URL for browser contexts
CSI_INDEED_PUBLISHER_ID=        # Indeed Publisher API id
CSI_CAPTCHA_API_KEY=            # 2captcha / anticaptcha key

# ---------- FlareSolverr ----------
CSI_FLARE_URL=http://localhost:8191
CSI_FLARE_TIMEOUT_MS=60000
CSI_FLARE_CACHE_SIZE=200
CSI_FLARE_DISABLED=0
CSI_CF_WAIT_MS=35000

# ---------- Alerts / Auth helpers ----------
CSI_ALERT_URL=                  # webhook for alerts
CSI_AUTH_USER=
CSI_AUTH_PASS=
CSI_AUTH_TOKEN=

# ---------- Cache ----------
CACHE_TTL=3600000               # ms

# ---------- Scheduler ----------
# In-process node-cron is OFF by default (unreliable on Render ephemeral/sleeping
# instances). Data updates run in GitHub Actions. Set 1 only on a long-lived host.
ENABLE_SCHEDULER=0

# ---------- Debug ----------
DEBUG=0
VA_DEBUG=0