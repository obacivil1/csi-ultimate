{
  "language": "en",
  "search": {
    "method": "GET",
    "endpoint": "/search/",
    "param": "keyword"
  },
  "extraction": {
    "adIdPattern": "/item/[^/]+-(\\d+)\\.html$",
    "titleCleanup": ["Gulf Classifieds", "Gulf Classified"],
    "phoneRegion": "GCC",
    "countryCodes": ["971", "966", "974", "968", "965", "973", "20", "962"],
    "currencies": ["AED", "SAR", "OMR", "QAR", "KWD", "BHD", "EGP", "JOD"],
    "selectors": {
      "title": ["h1", "[class*='details'] h1"],
      "description": ["P.description", ".description", "[class*='description']"],
      "phone": ["a[href^='tel:']"],
      "email": ["a[href^='mailto:']"],
      "whatsapp": ["a[href*='wa.me']", "a[href*='whatsapp.com/send']"],
      "location": ["[class*='location']", ".small_text"],
      "price": [".price", "[class*='price']"],
      "company": ["[class*='company']", "[class*='advertiser']"],
      "breadcrumb": [".breadcrumb a", "[class*='breadcrumb'] a"],
      "date": [".meta", "[class*='posted']", "[class*='date']"]
    }
  },
  "pagination": {
    "nextSelector": "a[rel='next'], a.next, [class*='next'] a, [class*='pagination'] a"
  },
  "categories": {
    "autoDiscover": true
  },
  "excludeUrlPatterns": ["/post/", "/yellow-pages/", "/page/", "/register", "/login"]
}